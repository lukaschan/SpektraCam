    "batch.memory_policy": {
      "comment": "Preview and batch export interface text. New copy; human editorial review pending.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos export one at a time. If a photo needs more memory, the others continue. Choose a smaller size to retry failed photos; completed photos will not export again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片将逐张导出。如某张照片所需内存不足，其余照片仍会继续导出。请选择较小尺寸以重试失败的照片；已完成的照片不会重复导出。"
          }
        }
      }
    },
    "batch.memory_stopped": {
